LOG_LEVEL=info
SERVER_MASTER=true
SCALAR_UI_ENABLED=true
DATABASE_URL=postgresql://postgres:123123@127.0.0.1:5433/postgres
JWT_SECRET=test1234
# 种子管理员（首次启动无管理员时自动创建）
SEED_ADMIN_PHONE=13888888888
SEED_ADMIN_PASSWORD=admin123!
S3_ENDPOINT=https://cos.ap-beijing.myqcloud.com
S3_DOMAIN=https://s3-dev.paidago.com
S3_SECRET_ID=your_s3_secret_id
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=paidago-dev-1395107217
OTLP_ENDPOINT=http://observe.prod.paidago.com:5081
OTLP_SERVICE_NAME=slab-local
OTLP_METADATA='{"authorization":"Basic you_token","organization":"default","stream-name":"default"}'
# 缓存后端（server 编译 feature 决定用哪个：kv-redb / kv-redis / 默认 pg 兜底）
CACHE_DB_PATH=./data/cache.redb
REDIS_URL=redis://127.0.0.1:6379
